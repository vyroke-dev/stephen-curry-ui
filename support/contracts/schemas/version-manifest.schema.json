{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stephen-curry-ui/contracts/version-manifest/1.0.0",
  "title": "version-manifest",
  "description": "Stephen Curry UI 4.1 protocol contract; illustrative $id namespace, not a live endpoint.",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "artifact_version",
    "design_system_version",
    "code_revision",
    "review_refs"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "design_system_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "code_revision": {
      "type": "string",
      "minLength": 1
    },
    "design_snapshot": {
      "type": "string"
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "quality_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
