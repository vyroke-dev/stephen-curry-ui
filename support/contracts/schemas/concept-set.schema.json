{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stephen-curry-ui/contracts/concept-set/1.0.0",
  "title": "concept-set",
  "description": "Stephen Curry UI 4.1 protocol contract; illustrative $id namespace, not a live endpoint.",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "design_system_version",
    "concepts"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "design_system_version": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "concepts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "creative_thesis",
          "experience_architecture",
          "layout_strategy",
          "interaction_grammar",
          "high_fidelity_artifacts",
          "design_system_version"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
          },
          "creative_thesis": {
            "type": "string",
            "minLength": 1
          },
          "experience_architecture": {
            "type": "string",
            "minLength": 1
          },
          "layout_strategy": {
            "type": "string",
            "minLength": 1
          },
          "interaction_grammar": {
            "type": "string",
            "minLength": 1
          },
          "high_fidelity_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "design_system_version": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
          },
          "distinctiveness_notes": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
