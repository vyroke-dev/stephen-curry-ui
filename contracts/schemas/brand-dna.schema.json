{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/stephen-curry-ui/contracts/brand-dna/1.0.0",
  "title": "brand-dna",
  "description": "Stephen Curry UI 4.0 protocol contract; illustrative $id namespace, not a live endpoint.",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "brand_name",
    "positioning",
    "design_principles",
    "status"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "brand_name": {
      "type": "string",
      "minLength": 1
    },
    "positioning": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "design_principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "existing_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "blocked"
      ]
    },
    "approval_ref": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
